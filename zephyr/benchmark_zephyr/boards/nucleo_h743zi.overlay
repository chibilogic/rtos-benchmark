/*
 * Device tree overlay per benchmark Zephyr su NUCLEO-H743ZI2.
 *
 * Aggiunge alias per il pin di test (PB0) e per il timer usato nel
 * test T1 (TIM2). Il resto della configurazione viene dal board file
 * standard di Zephyr (boards/arm/nucleo_h743zi).
 */

/ {
    aliases {
        bench-led = &bench_pin;
    };

    bench_pin: bench_pin {
        compatible = "gpio-leds";
        gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
        label = "Benchmark Test Pin (PB0)";
    };
};

/* TIM2 abilitato per il test T1 (IRQ wake-up) */
&timers2 {
    status = "okay";
    st,prescaler = <239>;     /* 240 MHz / 240 = 1 MHz timer clock */

    counter {
        status = "okay";
    };
};

/* USART3 e' gia' abilitato come console nel board file */
&usart3 {
    current-speed = <115200>;
};
